<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Bookmarks &amp; Highlights"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Add Bookmark Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Quick Bookmark"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etBookmarkReference"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Verse Reference (e.g. Genesis 1:1)"
                        android:inputType="text"
                        android:padding="12dp"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textColorHint="@color/HolyTextApplication_text_secondary"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etBookmarkText"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="Verse Text or Note"
                        android:inputType="textMultiLine"
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textColorHint="@color/HolyTextApplication_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSaveBookmark"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Save Bookmark"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bookmarks Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved Scripture Bookmarks"
                android:textColor="@color/HolyTextApplication_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <ProgressBar
                android:id="@+id/progressBarBookmarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyBookmarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No bookmarks saved yet. Use the form above or bookmark verses while searching!"
                android:textColor="@color/HolyTextApplication_text_secondary"
                android:textSize="15sp"
                android:gravity="center"
                android:visibility="gone"
                android:padding="20dp" />

            <!-- Dynamic Container for Bookmark Cards -->
            <LinearLayout
                android:id="@+id/containerBookmarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>