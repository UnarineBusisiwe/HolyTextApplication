<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/HolyTextApplication_background"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- HolyText heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HolyText"
            android:textColor="@color/HolyTextApplication_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp" />

        <!-- Tagline -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A Sanctuary for your soul."
            android:textColor="@color/HolyTextApplication_text_secondary"
            android:textSize="15sp"
            android:layout_marginBottom="35dp" />

        <!-- Register title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create your account"
            android:textColor="@color/HolyTextApplication_text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Register description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create an account to begin your HolyText journey."
            android:textColor="@color/HolyTextApplication_text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- Full Name -->

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:padding="16dp"
            android:backgroundTint="@color/HolyTextApplication_primary"
            android:textColor="@color/HolyTextApplication_text_primary"
            android:textColorHint="@color/HolyTextApplication_text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- Email -->

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:backgroundTint="@color/HolyTextApplication_primary"
            android:textColor="@color/HolyTextApplication_text_primary"
            android:textColorHint="@color/HolyTextApplication_text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- Password -->

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:backgroundTint="@color/HolyTextApplication_primary"
            android:textColor="@color/HolyTextApplication_text_primary"
            android:textColorHint="@color/HolyTextApplication_text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- Confirm Password -->

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:backgroundTint="@color/HolyTextApplication_primary"
            android:textColor="@color/HolyTextApplication_text_primary"
            android:textColorHint="@color/HolyTextApplication_text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- Register button -->

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Account"
            android:textColor="@color/HolyTextApplication_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/HolyTextApplication_primary"
            android:layout_marginBottom="18dp" />

        <!-- Login link -->

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="16dp"
            android:text="Already have an account? Sign in"
            android:textColor="@color/HolyTextApplication_accent"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>