<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Achievements &amp; Badges"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Summary Hero Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/HolyTextApplication_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvAchievementsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆  Faith Achievements"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvFaithPointsTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Total Faith Points: 0 FP"
                        android:textColor="@color/HolyTextApplication_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvUnlockedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Badges Unlocked: 0 / 6"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="14sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Milestones &amp; Badges"
                android:textColor="@color/HolyTextApplication_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Dynamic Container for Achievement Badges -->
            <LinearLayout
                android:id="@+id/containerAchievements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>