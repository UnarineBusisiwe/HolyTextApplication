<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Audio Bible"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Passage Selector Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Scripture Audio"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerAudioBook"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etAudioChapter"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="e.g. 1"
                        android:inputType="number"
                        android:padding="12dp"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textColorHint="@color/HolyTextApplication_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnLoadAudioPassage"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Load Scripture Audio"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Audio Player Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/HolyTextApplication_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tvAudioReference"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎧  Psalm 23"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvAudioStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Ready to play"
                        android:textColor="@color/HolyTextApplication_accent"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp" />

                    <!-- Media Control Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <Button
                            android:id="@+id/btnAudioPlay"
                            android:layout_width="120dp"
                            android:layout_height="56dp"
                            android:text="▶️ Play"
                            android:textAllCaps="false"
                            android:textColor="@color/HolyTextApplication_primary"
                            android:textStyle="bold"
                            android:backgroundTint="@color/HolyTextApplication_white"
                            android:layout_marginEnd="10dp" />

                        <Button
                            android:id="@+id/btnAudioStop"
                            android:layout_width="120dp"
                            android:layout_height="56dp"
                            android:text="⏹️ Stop"
                            android:textAllCaps="false"
                            android:textColor="@color/HolyTextApplication_white"
                            android:textStyle="bold"
                            android:backgroundTint="@color/HolyTextApplication_accent" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Scripture Text Preview Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scripture Text"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <ProgressBar
                        android:id="@+id/progressBarAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvAudioScripture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The Lord is my shepherd; I shall not want. He maketh me to lie down in green pastures..."
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="16sp"
                        android:lineSpacingExtra="6dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>