<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Back arrow toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="HolyText"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ⭐ HEADER CARD ⭐ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/HolyTextApplication_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 0 day streak"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="16sp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tvFaithPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 0 Faith Points"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Main action buttons -->
            <Button
                android:id="@+id/btnReadBible"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Read Bible"
                android:textAllCaps="false"
                android:textColor="@color/HolyTextApplication_white"
                android:textStyle="bold"
                android:backgroundTint="@color/HolyTextApplication_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnTrivia"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Bible Trivia"
                android:textAllCaps="false"
                android:textColor="@color/HolyTextApplication_white"
                android:textStyle="bold"
                android:backgroundTint="@color/HolyTextApplication_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Settings"
                android:textAllCaps="false"
                android:textColor="@color/HolyTextApplication_white"
                android:textStyle="bold"
                android:backgroundTint="@color/HolyTextApplication_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="@color/HolyTextApplication_white"
                android:textStyle="bold"
                android:backgroundTint="@color/HolyTextApplication_accent" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>