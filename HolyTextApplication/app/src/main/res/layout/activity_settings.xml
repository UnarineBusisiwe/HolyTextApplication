<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Back arrow toolbar with Settings icon -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="⚙️ Settings"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Settings Header Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/HolyTextApplication_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="32sp"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSettingsCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚙️ Preferences &amp; App Language"
                            android:textColor="@color/HolyTextApplication_white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSettingsCardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select language: English, Tshivenda, Sepedi"
                            android:textColor="@color/HolyTextApplication_accent"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Language -->
            <TextView
                android:id="@+id/tvLanguageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Language / Luambo / Polelo"
                android:textColor="@color/HolyTextApplication_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerLanguage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/HolyTextApplication_primary"
                android:layout_marginBottom="24dp" />

            <!-- Text size -->
            <TextView
                android:id="@+id/tvTextSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Size"
                android:textColor="@color/HolyTextApplication_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerTextSize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/HolyTextApplication_primary"
                android:layout_marginBottom="24dp" />

            <!-- Notifications -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Notifications"
                android:textColor="@color/HolyTextApplication_text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Settings"
                android:textAllCaps="false"
                android:textColor="@color/HolyTextApplication_white"
                android:textStyle="bold"
                android:backgroundTint="@color/HolyTextApplication_primary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnLogoutSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="@color/HolyTextApplication_white"
                android:textStyle="bold"
                android:backgroundTint="@color/HolyTextApplication_accent" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>