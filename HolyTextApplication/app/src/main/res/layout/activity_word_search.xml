<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Bible Word Search"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Progress & Word List Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/HolyTextApplication_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvWordSearchProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔤  Words Found: 0 / 5"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTargetWords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find: FAITH • GRACE • JESUS • PRAY • HOPE"
                        android:textColor="@color/HolyTextApplication_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Grid Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/gridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center" />

            </androidx.cardview.widget.CardView>

            <!-- Word Input Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Found a word in the grid?"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etWordGuess"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Type word (e.g. FAITH)"
                        android:inputType="textCapCharacters"
                        android:padding="12dp"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textColorHint="@color/HolyTextApplication_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSubmitWordGuess"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Submit Found Word"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>