<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Search Bible"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Search Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search Scripture"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter a verse reference or book passage (e.g. John 3:16, Psalm 23, Romans 8:28)"
                        android:textColor="@color/HolyTextApplication_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <EditText
                        android:id="@+id/etSearchQuery"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Search passage e.g. John 3:16"
                        android:inputType="text"
                        android:padding="16dp"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textColorHint="@color/HolyTextApplication_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSearchScripture"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="🔎  Search Verse"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Suggestions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Suggestions"
                android:textColor="@color/HolyTextApplication_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnSuggest1"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="John 3:16"
                    android:textColor="@color/HolyTextApplication_primary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnSuggest2"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Psalm 23"
                    android:textColor="@color/HolyTextApplication_primary"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Result Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSearchResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvSearchReference"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/HolyTextApplication_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvSearchContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="16sp"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnBookmarkResult"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="🔖  Save to Bookmarks"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:backgroundTint="@color/HolyTextApplication_accent" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>