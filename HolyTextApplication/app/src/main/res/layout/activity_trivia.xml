<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Bible Trivia Quiz"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Stats Bar Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/HolyTextApplication_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTriviaQuestionNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Question 1 of 5"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTriviaScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Score: 0"
                        android:textColor="@color/HolyTextApplication_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quiz Question Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/HolyTextApplication_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvTriviaQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Who was swallowed by a great fish when running away from God's command?"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp" />

                    <!-- Option 1 -->
                    <Button
                        android:id="@+id/btnOption1"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Option 1"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:layout_marginBottom="10dp" />

                    <!-- Option 2 -->
                    <Button
                        android:id="@+id/btnOption2"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Option 2"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:layout_marginBottom="10dp" />

                    <!-- Option 3 -->
                    <Button
                        android:id="@+id/btnOption3"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Option 3"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:layout_marginBottom="10dp" />

                    <!-- Option 4 -->
                    <Button
                        android:id="@+id/btnOption4"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Option 4"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_primary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvTriviaFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/HolyTextApplication_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnNextQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Next Question ➡️"
                        android:textAllCaps="false"
                        android:textColor="@color/HolyTextApplication_white"
                        android:textStyle="bold"
                        android:backgroundTint="@color/HolyTextApplication_accent"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>