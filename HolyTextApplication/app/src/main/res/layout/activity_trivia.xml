<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/HolyTextApplication_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/HolyTextApplication_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Bible Trivia"
        app:titleTextColor="@color/HolyTextApplication_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ⭐ QUIZ CONTAINER ⭐ -->
            <LinearLayout
                android:id="@+id/containerQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvQuestionProgress"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Question 1 of 8"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/HolyTextApplication_primary" />

                    <TextView
                        android:id="@+id/tvFaithPointsEarned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 0 FP"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/HolyTextApplication_primary" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressQuiz"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/ic_launcher_background"
                    android:progress="12"
                    android:max="100"
                    android:layout_marginBottom="20dp" />

                <!-- Question Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/HolyTextApplication_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:text="Who built the Ark according to God's command?"
                        android:textColor="@color/HolyTextApplication_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="4dp" />
                </androidx.cardview.widget.CardView>

                <!-- Options -->
                <Button
                    android:id="@+id/btnOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="A. Noah"
                    android:textAllCaps="false"
                    android:textColor="@color/HolyTextApplication_text_primary"
                    android:backgroundTint="@color/HolyTextApplication_white"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="B. Moses"
                    android:textAllCaps="false"
                    android:textColor="@color/HolyTextApplication_text_primary"
                    android:backgroundTint="@color/HolyTextApplication_white"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="C. Abraham"
                    android:textAllCaps="false"
                    android:textColor="@color/HolyTextApplication_text_primary"
                    android:backgroundTint="@color/HolyTextApplication_white"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="D. David"
                    android:textAllCaps="false"
                    android:textColor="@color/HolyTextApplication_text_primary"
                    android:backgroundTint="@color/HolyTextApplication_white"
                    android:layout_marginBottom="16dp" />

                <!-- Feedback Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/HolyTextApplication_white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvFeedbackTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Correct! 🎉"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/HolyTextApplication_primary" />

                        <TextView
                            android:id="@+id/tvFeedbackExplanation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Noah built the ark as commanded in Genesis 6."
                            android:textColor="@color/HolyTextApplication_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnNextQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Next Question"
                    android:textAllCaps="false"
                    android:textColor="@color/HolyTextApplication_white"
                    android:textStyle="bold"
                    android:backgroundTint="@color/HolyTextApplication_primary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ⭐ RESULT CONTAINER ⭐ -->
            <LinearLayout
                android:id="@+id/containerResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/HolyTextApplication_primary"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvResultTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trivia Completed! 🎉"
                            android:textColor="@color/HolyTextApplication_white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResultScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Score: 8 / 8"
                            android:textColor="@color/HolyTextApplication_white"
                            android:textSize="18sp"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/tvResultFaithPoints"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ +80 Faith Points Earned!"
                            android:textColor="@color/HolyTextApplication_white"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnPlayAgain"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Play Again"
                    android:textAllCaps="false"
                    android:textColor="@color/HolyTextApplication_white"
                    android:textStyle="bold"
                    android:backgroundTint="@color/HolyTextApplication_primary"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnBackHome"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Back to Home"
                    android:textAllCaps="false"
                    android:textColor="@color/HolyTextApplication_white"
                    android:textStyle="bold"
                    android:backgroundTint="@color/HolyTextApplication_accent" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>